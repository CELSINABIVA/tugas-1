# ==========================================
# 2. STACK
# Fitur Undo
# Prinsip LIFO (Last In First Out)
# ==========================================

stack = []


def push(aktivitas):
    stack.append(aktivitas)


def pop():
    if len(stack) == 0:
        print("Tidak ada aktivitas untuk di-undo.")
    else:
        aktivitas = stack.pop()
        print("Undo:", aktivitas)


print("\n=== STACK / UNDO ===")

push("Menambahkan Ahmad Fauzi")
push("Menambahkan Siti Rahma")
push("Mengubah data Budi Santoso")

print("Aktivitas:")
print(stack)

print("\nMelakukan Undo:")
pop()

print("Aktivitas setelah Undo:")
print(stack)


# ==========================================
# 3. QUEUE
# Sistem antrean pengolahan data
# Prinsip FIFO (First In First Out)
# ==========================================

from collections import deque

queue = deque()


def enqueue(nama):
    queue.append(nama)


def dequeue():
    if len(queue) == 0:
        print("Antrean kosong.")
    else:
        mahasiswa = queue.popleft()
        print("Melayani:", mahasiswa)


print("\n=== QUEUE / ANTREAN ===")

enqueue("Ahmad Fauzi")
enqueue("Siti Rahma")
enqueue("Budi Santoso")
enqueue("Dewi Lestari")
enqueue("Rizki Pratama")

print("Antrean:")
print(list(queue))

print("\nProses pelayanan:")
dequeue()

print("\nAntrean setelah pelayanan:")
print(list(queue))


